APP_ENV=dev
APP_NAME=session-maintenance-system
APP_HOST=0.0.0.0
APP_PORT=8080

# 项目根目录（替换为实际路径）
DEPLOY_ROOT=D:\path\to\session-maintenance-system
RUNTIME_ROOT=D:\path\to\session-maintenance-system\runtime

# SQLite 数据库（自动创建）
DATABASE_URL=sqlite+pysqlite:///D:/path/to/session-maintenance-system/runtime/session_maintenance.db

# MySQL 连接（用于读取 ods_cookie_playwright 等表）
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ods

# 天巡云账号（用于 cookie 刷新等场景）
TXY_ACCOUNT=店铺名:IT账号
TXY_PASSWORD=your-password

# 飞书机器人 Webhook（任务通知用）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
