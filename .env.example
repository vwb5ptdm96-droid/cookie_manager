# ============================================================
# session-maintenance-system 环境变量模板
# 用法：复制为 .env 后填写。.env 不进 git，每台机器单独配置。
# 未设置的项走代码自动检测的默认值，无需配置即可运行。
# 所有路径均支持相对项目根目录的相对写法，跨机器可移植。
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=dev
APP_NAME=session-maintenance-system
APP_HOST=0.0.0.0
APP_PORT=8081

# ---------- 路径（可选，默认自动检测，通常不用配） ----------
# 不配置时：
#   DEPLOY_ROOT  = <项目根目录>（由代码位置自动推导）
#   RUNTIME_ROOT = <项目根目录>\runtime
#   DATABASE_URL = sqlite+pysqlite:///<项目根目录>/runtime/session_maintenance.db
# 如需自定义，写相对路径即可，例如：
# DEPLOY_ROOT=.
# RUNTIME_ROOT=runtime
# DATABASE_URL=sqlite+pysqlite:///runtime/session_maintenance.db

# ---------- 外部依赖（每台机器按实际填写） ----------
# MySQL（用于读取 ods_cookie_playwright 等表，health 链路需要）
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=ods

# 天巡云账号（cookie 刷新等场景）
TXY_ACCOUNT=店铺名:IT账号
TXY_PASSWORD=your-password

# 飞书机器人 Webhook（任务通知）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# Cookie 扩展采集接口密钥（X-API-Key 校验，留空则关闭鉴权仅供本地联调；生产必填）
COOKIE_SYNC_API_KEY=
